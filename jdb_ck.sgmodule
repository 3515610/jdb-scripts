#!name=加多宝CK自动同步青龙
#!desc=打开加多宝小程序即自动抓取 apitoken 和 unique_identity 同步到青龙
#!system=ios

[Script]
# ⚠️ 核心修复：精准拦截真正的抽奖和签到接口，彻底避开垃圾埋点请求
jdb_ck_sync = type=http-request, pattern=^https?:\/\/api-mp\.jdbchina\.com\/(thirty\.jdb\/api\/lottery|geement\.marketingplay\/api\/v1\/signin), script-path=https://cdn.jsdelivr.net/gh/3515610/jdb-scripts@main/jdb_ck_v5.js, requires-body=false, timeout=15

[MITM]
hostname = %APPEND% api-mp.jdbchina.com
